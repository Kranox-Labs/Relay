# The settings of the relay. Copy this file to .env and fill in the values. The relay checks each one at startup.
# The address and the port on which the relay answers. Keep 127.0.0.1 on a machine without a proxy in front.
RELAY_HOST=
RELAY_PORT=
# The path of the file that holds the API key of ChangeNOW on one line, such as ../../secret/changenow.txt.
CHANGENOW_API_KEY_FILE=
# Optional: the paths of the files that hold the key of Alchemy or of the PRO API of Blockscout on one line, for the
# privacy scan of an address on Robinhood Chain. The relay prefers Alchemy. Without either, the scan answers that the
# relay cannot scan yet.
ALCHEMY_API_KEY_FILE=
BLOCKSCOUT_API_KEY_FILE=
# The path of the file that holds the secret of the read tokens of swaps on one line: 64 hex digits from a random
# source, such as the output of "openssl rand -hex 32". The server makes its own on the first deploy.
SWAP_TOKEN_KEY_FILE=
